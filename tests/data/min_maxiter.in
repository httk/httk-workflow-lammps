# Tiny LJ liquid, ~100 atoms, 100 steps - smoke test fixture
units       lj
atom_style  atomic
dimension   3
boundary    p p p

lattice     fcc 0.8442
region      box block 0 3 0 3 0 3
create_box  1 box
create_atoms 1 box

mass        1 1.0
pair_style  lj/cut 2.5
pair_coeff  1 1 1.0 1.0 2.5

velocity    all create 1.0 87287 loop geom

neighbor    0.3 bin
neigh_modify every 20 delay 0 check no



thermo      10
thermo_style custom step temp pe etotal press

displace_atoms all random 0.1 0.1 0.1 123
minimize 0.0 1.0e-12 5 1000
